#!/usr/bin/env php
<?php

foreach ([$GLOBALS['_composer_autoload_path'] ?? null, __DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if ($autoload !== null && is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (! class_exists(PetarSpasic\LaravelHouse\Kanban\Console\Standalone::class)) {
    fwrite(STDERR, "kanban: run vendor/bin/kanban in a project that requires petar-spasic/laravel-house\n");
    exit(1);
}

// --in=<dir> first: run as if from <dir> (Guard runs a card agent's command this way, in its card)
if (str_starts_with($_SERVER['argv'][1] ?? '', '--in=')) {
    chdir(substr(array_splice($_SERVER['argv'], 1, 1)[0], 5)) || exit(2);
    // the command of the card's own agent: rebuild-branch takes it for its worker
    putenv('KANBAN_IN=1');
}

if (PetarSpasic\LaravelHouse\Kanban\Support\Paths::inCardContainer((string) getcwd())) {
    fwrite(STDERR, "kanban: vendor/bin/kanban runs on the host, not in the card's container. Your shell already starts in your card: drop any `cd … &&`, pipe or chain, and run `vendor/bin/kanban …` as the whole command, never inside a script\n");
    exit(1);
}

if (($main = PetarSpasic\LaravelHouse\Kanban\Console\Standalone::mainCheckoutBinary((string) ($_SERVER['SCRIPT_FILENAME'] ?? ''))) !== null) {
    passthru(implode(' ', array_map('escapeshellarg', [PHP_BINARY, $main, ...array_slice($_SERVER['argv'], 1)])), $exit);
    exit($exit);
}

exit(PetarSpasic\LaravelHouse\Kanban\Console\Standalone::run($_SERVER['argv']));
