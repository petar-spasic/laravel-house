{
    "name": "petar-spasic/laravel-kanban",
    "description": "Git-backed kanban board, worktree workflow and Claude Code hooks for Laravel projects (dev-only).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "kanban", "claude-code", "agents", "git", "worktree"],
    "authors": [
        { "name": "Petar Spasic", "email": "spasicpetar@gmail.com" }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": { "PetarSpasic\\Kanban\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PetarSpasic\\Kanban\\Tests\\": "tests/" }
    },
    "bin": ["bin/kanban"],
    "extra": {
        "laravel": {
            "providers": ["PetarSpasic\\Kanban\\KanbanServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
