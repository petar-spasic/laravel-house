{
    "name": "petar-spasic/laravel-house",
    "description": "House skills for Laravel projects, installed into Claude Code by Laravel Boost: project setup with per-layer CLAUDE.md rules, Docker hosting behind Caddy, laravel-kanban adoption, and the validation:export command.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "boost", "claude-code", "skills", "docker", "caddy", "frankenphp", "sveltekit", "htmx", "validation", "zod"],
    "authors": [
        { "name": "Petar Spasic", "email": "spasicpetar@gmail.com" }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": { "PetarSpasic\\LaravelHouse\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["PetarSpasic\\LaravelHouse\\LaravelHouseServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
