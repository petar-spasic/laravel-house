# The local image's Caddy (Dockerfile.local): PHP to php-fpm, the sites from docker/Caddyfile.local.
{
	# Here only: Octane drives FrankenPHP through the admin API (SKILL trap: Octane's status, reload or stop fail).
	admin off
	auto_https off
	persist_config off
	servers {
		# Never private_ranges: the LAN and the Docker gateway are private ranges.
		# SKILL trap: Anyone on the LAN opens /horizon.
		trusted_proxies static 127.0.0.1/8
		trusted_proxies_strict
	}
}

(php) {
	php_fastcgi 127.0.0.1:9000 {
		# An Xdebug session may hold a request for minutes.
		read_timeout 30m
	}
}
# if:spa

# The e2e sites' own php-fpm (docker/php-fpm-e2e.conf): Xdebug reads its mode once, at php-fpm's start, so only a
# second master runs the browser tests without it.
(e2e_php) {
	php_fastcgi 127.0.0.1:9001 {
		import e2e_env
	}
}
# endif

import /app/docker/Caddyfile.local
