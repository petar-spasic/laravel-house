# unless:spa
# Local sites: Vite's dev paths and HMR socket to the vite program when one runs, everything else to PHP.
# endif
# if:spa
# Local sites: Laravel's paths to PHP, everything else to SvelteKit's dev server; two loopback sites for browser tests.
# endif
# Not a config of its own: docker/Caddyfile.fpm (the local image, php-fpm) and docker/Caddyfile.agent (the agent
# image, Octane) set the global options and the PHP handler, `(php)`, then import this file. Read from the checkout:
# `supervisorctl restart app:caddy` (app:web in the agent image) applies an edit.

# unless:spa
:8080 {
	route {
		# Stock caddy has no br encoder.
		encode zstd gzip

		# Vite's paths; /__vite_hmr is vite.config.js server.ws.path. A root-level directory the frontend
		# imports from joins this list and server.fs.allow together; for vendor/ list /vendor/<package>/*,
		# never all of /vendor/ (public/vendor/ is Laravel's). No route lives under these prefixes.
		@vite path /@vite/* /@id/* /@fs/* /@react-refresh /__open-in-editor /__laravel_vite_plugin__/fonts/* /resources/* /node_modules/* /__vite_hmr
		handle @vite {
			reverse_proxy 127.0.0.1:5173
		}

		handle {
			root * /app/public
			@hidden {
				path */.*
				not path /.well-known/*
			}
			respond @hidden 404
			# A PHP file in public/ other than index.php never runs by its URL (Octane's worker only through
			# (php)'s rewrite), nor a subdirectory's index.php through its directory URL; a missing /x.php
			# still reaches Laravel, as in prod.
			@phpfile {
				file {
					try_files {path}
					split_path .php
				}
				path *.php *.php/*
				not path /index.php /index.php/*
			}
			respond @phpfile 404
			@phpdir {
				file {path}/index.php
				not path /
			}
			respond @phpdir 404
			import php
			file_server
		}
	}
}
# endif
# if:spa
# Laravel's public/ with the PHP guards. A PHP file other than index.php never runs by its URL (Octane's worker only
# through (php)'s rewrite), nor a subdirectory's index.php through its directory URL; a missing /x.php still reaches
# Laravel, as in prod.
(laravel_root) {
	root * /app/public
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404
	@phpfile {
		file {
			try_files {path}
			split_path .php
		}
		path *.php *.php/*
		not path /index.php /index.php/*
	}
	respond @phpfile 404
	@phpdir {
		file {path}/index.php
		not path /
	}
	respond @phpdir 404
}

# Browser tests (docker/e2e.sh): the only list of the test env. Both images' (e2e_php) import it, inside php-fpm's
# FastCGI params or FrankenPHP's php_server, and e2e.sh reads its env lines (one `env NAME value` per line, no quotes).
# They win over the container env in $_SERVER; a cached config ignores them. REDIS_DB and REDIS_CACHE_DB keep e2e sessions, cache, rate limits and locks
# apart from dev, so the reset's cache:clear flushes only DB 3. QUEUE_CONNECTION=sync: the dev Horizon never runs a
# test job against the dev database. APP_URL points mailed links at the e2e site; SANCTUM_STATEFUL_DOMAINS matches
# Chromium's Origin there. The origin is localhost, never 127.0.0.1: WebAuthn refuses an IP as its relying party.
# APP_E2E (config('app.e2e')) is the one test switch: every named rate limiter answers Limit::none() under it, and a
# test-only behaviour, such as a faked outside system, reads it in the app. This list never grows per feature.
(e2e_env) {
	env APP_E2E true
	env APP_URL http://localhost:8090
	env DB_DATABASE {{app}}_test
	env REDIS_DB 2
	env REDIS_CACHE_DB 3
	env QUEUE_CONNECTION sync
	env MAIL_MAILER log
	env BROADCAST_CONNECTION null
	env SANCTUM_STATEFUL_DOMAINS localhost:8090
}

:8080 {
	route {
		# Stock caddy has no br encoder.
		encode zstd gzip
		@healthz path /healthz /healthz/*
		respond @healthz 404
		# frontend/.env holds SvelteKit's private env: refused here as well as by Vite's server.fs.deny. Only these:
		# Vite's own /.svelte-kit/* and /node_modules/.vite/* are dot paths too.
		@dotenv path /.env /.env.*
		respond @dotenv 404

		# Laravel's paths; everything else is SvelteKit's. Never /horizon*: it also matches /horizonX. A new Laravel
		# route moves under /api or joins @backend here and in docker/Caddyfile.
		@backend path /api/* /sanctum/* /horizon /horizon/* /up /storage/* /kanban /kanban/*
		handle @backend {
			import laravel_root
			import php
			# php_fastcgi runs PHP only: /storage files need this.
			file_server
		}

		# if:reverb
		# Echo's WebSocket on the page's own origin.
		@reverb path /app/*
		handle @reverb {
			reverse_proxy 127.0.0.1:8081
		}

		# endif
		# vite dev, its HMR socket included.
		handle {
			reverse_proxy 127.0.0.1:5173 {
				header_up X-Real-IP {client_ip}
			}
		}
	}
}

# The browser's origin in browser tests, http://localhost:8090: Laravel's paths on the test env, the rest from the
# production build of frontend/. Loopback only, never published; Chromium falls back from ::1 to 127.0.0.1.
:8090 {
	bind 127.0.0.1
	route {
		encode zstd gzip
		@healthz path /healthz /healthz/*
		respond @healthz 404

		@backend path /api/* /sanctum/* /up /storage/*
		handle @backend {
			# Laravel 13 passes a write with Sec-Fetch-Site: same-origin without its CSRF token, and browsers send that
			# header only to https, localhost and loopback origins. Stripped here, every browser write takes the token
			# path that a LAN http origin takes.
			request_header -Sec-Fetch-Site
			import laravel_root
			import e2e_php
			file_server
		}

		import /app/docker/Caddyfile.frontend
	}
}

# SvelteKit's API_INTERNAL_URL in browser tests: a second origin, because SvelteKit answers a server-side fetch to its
# own origin itself.
:8091 {
	bind 127.0.0.1
	route {
		import laravel_root
		import e2e_php
		file_server
	}
}
# endif
