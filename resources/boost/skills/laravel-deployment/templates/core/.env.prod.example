# {{app}} — production env (docker compose --env-file .env.prod). Copy to
# .env.prod on the host and fill in. Never commit .env.prod.
#
# Only environment-dependent values live here; everything else is defaulted in
# config/*.php.
APP_NAME={{app_name}}
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# unless:spa
APP_URL=https://{{domain}}
# Comma-separated IPs/CIDRs the reverse proxy's requests arrive from inside the
# container (the compose network's gateway). Required: the entrypoint refuses an empty value.
TRUSTED_PROXIES=
# endif
# if:spa
# A bare origin, no path or trailing slash: also the SvelteKit server's ORIGIN and the build's PUBLIC_APP_URL.
# Never ORIGIN (derived from APP_URL; an empty one crashes adapter-node), PROTOCOL_HEADER (ignored once ORIGIN is
# set) or SESSION_DOMAIN (unset gives the host-only cookie one origin needs; .{{domain}} would share the session with
# subdomains).
APP_URL=https://{{domain}}
# Comma-separated: 127.0.0.1 (SvelteKit's server-side calls, which carry the browser's address) and the reverse
# proxy's address as its requests arrive in the container (the compose network's gateway). Add the gateway: the
# entrypoint refuses a value without both.
TRUSTED_PROXIES=127.0.0.1,
# The page origins Sanctum treats as the browser (host[:port], no scheme). Empty makes every browser /api call 401.
SANCTUM_STATEFUL_DOMAINS={{domain}}
# endif
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE={{app}}
# unless:tenancy
DB_USERNAME={{app}}
DB_PASSWORD=
# endif
# if:tenancy
# Fixed: the app's role, created by docker/postgres/roles.sql; owns nothing, so row-level security applies.
DB_USERNAME={{app}}_app
DB_PASSWORD=
# {{app}}, Postgres's superuser and the tables' owner: migrations only (pgsql_owner). Keep the password the volume
# was created with.
DB_OWNER_PASSWORD=
# endif

SESSION_SECURE_COOKIE=true
REDIS_HOST=redis
REDIS_PORT=6379
# if:reverb

# Reverb listens on 8081 in the container and the broadcaster connects there. The app id, key and secret match on
# server, broadcaster and client.
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# unless:spa
# Echo's address in the browser; the reverse proxy sends the public WebSocket host to WS_PORT.
REVERB_PUBLIC_HOST={{domain}}
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
# endif
# endif

# Not `log`: that mailer writes at debug level, which LOG_LEVEL=info drops, so mail would vanish silently.
MAIL_MAILER=smtp
MAIL_HOST=smtp.{{domain}}
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@{{domain}}

# Social sign-in, off until the project builds it: the enabled providers, then each one's client (callback URLs:
# CLAUDE.md, Hosting).
# SOCIAL_PROVIDERS=google,github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admins until roles exist (the viewHorizon gate): comma-separated emails. ProductionSeeder (DATABASE_SEED=true)
# creates each missing address verified; its owner sets a password through the password-reset flow. An existing
# account is left untouched: the seed output reports an unverified one, and /horizon stays closed to it.
ADMIN_EMAILS=
# The operator ProductionSeeder creates when both are set and the account is missing (OPERATOR_PASSWORD applies
# only then); otherwise no operator. env() reads the words true, false, null and empty as a boolean, null or
# empty value, so such a password is not seeded: pick another.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# true runs ProductionSeeder at boot: reference data, the operator, every ADMIN_EMAILS address. Idempotent, no faker.
DATABASE_SEED=false

# Octane workers × PHP_MEMORY_LIMIT (512M), plus Horizon's processes, must fit the
# RAM of the box: a number, never "auto" (one per core).
OCTANE_WORKERS=4
# WARN keeps request lines out of `docker logs`; INFO logs every request.
OCTANE_LOG_LEVEL=WARN
# Redis ceiling (one instance, noeviction).
REDIS_MAXMEMORY=1gb
# Loopback port the web container is published on (the reverse proxy targets it).
WEB_PORT={{web_port}}
