#!/bin/sh
# Fake df: the filesystem has room, but only 4% of its inodes are free.
case " $* " in
    *" -i "*) printf 'Filesystem Inodes IUsed IFree IUse%% Mounted on\ntmpfs 1000000 960000 40000 96%% /tmp\n' ;;
    *) printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\ntmpfs 1000000 80000 920000 8%% /tmp\n' ;;
esac
