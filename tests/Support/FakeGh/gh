#!/usr/bin/env php
<?php

/*
 * Fake `gh` for the E2E tests. Every call appends its argv, as a JSON array, to $FAKE_GH_DIR/calls.jsonl.
 *
 * FAKE_GH_AUTH=fail     `auth status` exits 1 (signed out)
 * FAKE_GH_HITS=<json>   what `issue list --json …` prints (default [])
 * FAKE_GH_URL=<url>     what `issue create` prints (default an issue URL numbered 101)
 */

$dir = getenv('FAKE_GH_DIR') ?: sys_get_temp_dir().'/fake-gh';
@mkdir($dir, 0775, true);
$args = array_slice($argv, 1);
file_put_contents($dir.'/calls.jsonl', json_encode($args, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n", FILE_APPEND | LOCK_EX);

$at = array_search('--repo', $args, true);
$repo = $at === false ? 'owner/repo' : $args[$at + 1];
$command = implode(' ', array_slice($args, 0, 2));
if ($command === 'auth status') {
    exit(getenv('FAKE_GH_AUTH') === 'fail' ? 1 : 0);
}
echo match ($command) {
    'issue list' => getenv('FAKE_GH_HITS') ?: '[]',
    'issue create' => getenv('FAKE_GH_URL') ?: "https://github.com/{$repo}/issues/101",
    'issue comment' => "https://github.com/{$repo}/issues/{$args[2]}#issuecomment-1",
    default => exit((int) (fwrite(STDERR, "fake gh: unsupported {$command}\n") > 0)),
}, "\n";
